# --- docker-compose (firebird service) ---
FIREBIRD_DATABASE_FILE=firemapper.fdb
FIREBIRD_PORT=3050
# FIREBIRD_EXTRA_USER=app
# FIREBIRD_EXTRA_PASSWORD=changeme

# --- app (src/database/firebird.ts) ---
# Required unless DATABASE_URL is set. Path is resolved by the Firebird
# server, not the client — with docker-compose this is the path inside the
# container: /var/lib/firebird/data/<FIREBIRD_DATABASE_FILE>
FIREBIRD_DATABASE=/var/lib/firebird/data/firemapper.fdb
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey

# Optional — see README.md for defaults
# FIREBIRD_ROLE=
# FIREBIRD_ENCODING=UTF8
# FIREBIRD_LOWERCASE_KEYS=false
# FIREBIRD_POOL_SIZE=5

# Optional — a firebird:// connection string overrides every FIREBIRD_* var above
# DATABASE_URL=firebird://SYSDBA:masterkey@127.0.0.1:3050//var/lib/firebird/data/firemapper.fdb
